<div class="max-w-md mx-auto">
  <div class="card bg-base-100 shadow-md border border-base-content/10">
    <div class="card-body p-8">
      <h1 class="text-2xl font-black mb-6 text-center">Criar conta no GameHub</h1>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="form-control mb-4">
          <%= f.label :username, class: "label label-text font-semibold" %>
          <%= f.text_field :username, autofocus: true, class: "input input-bordered w-full" %>
        </div>

        <div class="form-control mb-4">
          <%= f.label :email, class: "label label-text font-semibold" %>
          <%= f.email_field :email, autocomplete: "email", class: "input input-bordered w-full" %>
        </div>

        <div class="form-control mb-4">
          <%= f.label :password, class: "label label-text font-semibold" %>
          <% if @minimum_password_length %>
            <span class="label-text-alt text-base-content/50">(mínimo <%= @minimum_password_length %> caracteres)</span>
          <% end %>
          <%= f.password_field :password, autocomplete: "new-password", class: "input input-bordered w-full" %>
        </div>

        <div class="form-control mb-6">
          <%= f.label :password_confirmation, "Confirme a senha", class: "label label-text font-semibold" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input input-bordered w-full" %>
        </div>

        <%= f.submit "Criar conta", class: "btn btn-primary w-full" %>
      <% end %>

      <div class="divider text-xs text-base-content/50">ou</div>

      <%= button_to "Continuar com Facebook", user_facebook_omniauth_authorize_path, class: "btn btn-outline w-full", data: { turbo: false } %>

      <p class="text-center mt-6 text-sm">
        Já tem conta?
        <%= link_to "Entrar", new_session_path(resource_name), class: "link link-primary font-semibold" %>
      </p>
    </div>
  </div>
</div>
