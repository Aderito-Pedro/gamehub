<div class="max-w-md mx-auto">
  <div class="card bg-base-100 shadow-md border border-base-content/10">
    <div class="card-body p-8">
      <h1 class="text-2xl font-black mb-6 text-center">Entrar no GameHub</h1>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="form-control mb-4">
          <%= f.label :email, class: "label label-text font-semibold" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input input-bordered w-full" %>
        </div>

        <div class="form-control mb-2">
          <%= f.label :password, class: "label label-text font-semibold" %>
          <%= f.password_field :password, autocomplete: "current-password", class: "input input-bordered w-full" %>
        </div>

        <% if devise_mapping.recoverable? %>
          <div class="text-right mb-4">
            <%= link_to "Esqueceu a senha?", new_password_path(resource_name), class: "link link-hover text-xs text-base-content/60" %>
          </div>
        <% end %>

        <% if devise_mapping.rememberable? %>
          <div class="form-control mb-4">
            <label class="label cursor-pointer justify-start gap-2 p-0">
              <%= f.check_box :remember_me, class: "checkbox checkbox-sm" %>
              <span class="label-text">Lembrar-me</span>
            </label>
          </div>
        <% end %>

        <%= f.submit "Entrar", class: "btn btn-primary w-full" %>
      <% end %>

      <div class="divider text-xs text-base-content/50">ou</div>

      <div class="space-y-2">
        <%= button_to "Continuar com Facebook", user_facebook_omniauth_authorize_path, class: "btn btn-outline w-full", data: { turbo: false } %>
        <%= button_to "Jogar como Visitante", guest_login_path, method: :post, class: "btn btn-secondary btn-outline w-full" %>
      </div>

      <p class="text-center mt-6 text-sm">
        Ainda não tem conta?
        <%= link_to "Criar conta", new_registration_path(resource_name), class: "link link-primary font-semibold" %>
      </p>
    </div>
  </div>
</div>
