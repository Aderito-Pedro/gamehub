<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Gamehub" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Gamehub">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400&display=swap" rel="stylesheet">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-base-300 text-base-content min-h-screen flex flex-col antialiased">
    <!-- Navbar -->
    <header class="navbar sticky top-0 z-50 bg-gradient-to-br from-base-200/90 via-base-100/85 to-base-200/90 backdrop-blur-md border-b border-base-content/10 px-4 sm:px-6 min-h-16 shadow-sm">
      <div class="flex-1">
        <%= link_to root_path, class: "btn btn-ghost text-xl sm:text-2xl font-black tracking-tight px-2" do %>
          <span class="text-2xl">🎮</span>
          <span class="bg-gradient-to-r from-primary via-secondary to-accent bg-clip-text text-transparent">GameHub</span>
        <% end %>
      </div>

      <% nav_link = ->(label, path) {
        active = current_page?(path)
        link_to label, path, class: [
          "relative pb-1 text-sm tracking-wide transition-opacity",
          "after:content-[''] after:absolute after:left-0 after:bottom-0 after:h-px after:w-full after:bg-current after:origin-left after:transition-transform after:duration-300",
          active ? "opacity-100 font-medium after:scale-x-100" : "font-light opacity-50 hover:opacity-90 after:scale-x-0 hover:after:scale-x-100"
        ].join(" ")
      } %>
      <nav class="flex-none gap-6 hidden md:flex items-center px-4">
        <%= nav_link.call("Início", root_path) %>
        <%= nav_link.call("Leaderboard", global_leaderboard_path) %>
        <%= nav_link.call("Facebook", facebook_integration_path) %>
      </nav>

      <div class="flex-none flex items-center gap-2 ml-2">
        <!-- Theme toggle: persists across Turbo navigation via data-turbo-permanent, pure CSS (no JS) -->
        <label id="theme-toggle" data-turbo-permanent class="swap swap-rotate btn btn-ghost btn-circle btn-sm sm:btn-md" aria-label="Alternar tema claro/escuro">
          <input type="checkbox" class="theme-controller" value="gamehublight" />
          <svg class="swap-on h-5 w-5 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 4.5a1 1 0 0 1 1 1V7a1 1 0 1 1-2 0V5.5a1 1 0 0 1 1-1Zm0 5a3.5 3.5 0 1 1 0 7 3.5 3.5 0 0 1 0-7Zm7.5 3.5a1 1 0 0 1-1 1H17a1 1 0 1 1 0-2h1.5a1 1 0 0 1 1 1Zm-14 0a1 1 0 0 1-1 1H3a1 1 0 1 1 0-2h1.5a1 1 0 0 1 1 1Zm11.03-6.03a1 1 0 0 1 0 1.42l-1.06 1.06a1 1 0 1 1-1.42-1.42l1.06-1.06a1 1 0 0 1 1.42 0Zm-9.02 9.02a1 1 0 0 1 0 1.42l-1.06 1.06a1 1 0 1 1-1.42-1.42l1.06-1.06a1 1 0 0 1 1.42 0ZM12 17.5a1 1 0 0 1 1 1V20a1 1 0 1 1-2 0v-1.5a1 1 0 0 1 1-1Zm5.55-1.03 1.06 1.06a1 1 0 0 1-1.42 1.42l-1.06-1.06a1 1 0 1 1 1.42-1.42Zm-11.1 0a1 1 0 0 1 1.42 1.42l-1.06 1.06a1 1 0 1 1-1.42-1.42l1.06-1.06Z"/></svg>
          <svg class="swap-off h-5 w-5 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M21.64 13a1 1 0 0 0-1.05-.14 8.05 8.05 0 0 1-3.37.73 8.15 8.15 0 0 1-8.14-8.14 8.05 8.05 0 0 1 .73-3.37A1 1 0 0 0 8.4.05 10.15 10.15 0 1 0 22 14.24a1 1 0 0 0-.36-1.24Z"/></svg>
        </label>

        <% if user_signed_in? %>
          <div class="dropdown dropdown-end">
            <label tabindex="0" class="btn btn-ghost btn-circle avatar ring-1 ring-primary/30 hover:ring-primary transition-all">
              <div class="w-9 rounded-full bg-gradient-to-br from-primary to-secondary text-primary-content flex items-center justify-center">
                <% if current_user.avatar_url.present? %>
                  <img src="<%= current_user.avatar_url %>" alt="Avatar" class="rounded-full">
                <% else %>
                  <span class="text-xs font-bold"><%= current_user.display_name[0..1].upcase %></span>
                <% end %>
              </div>
            </label>
            <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-[1] p-2 shadow-xl bg-base-100 rounded-box w-56 border border-base-content/10">
              <li class="menu-title text-xs"><%= current_user.display_name %></li>
              <li><%= link_to "👤 Meu Perfil", user_path(current_user) %></li>
              <li><%= link_to "🏅 Conquistas", achievements_user_path(current_user) %></li>
              <li class="border-t border-base-content/10 mt-2 pt-1">
                <%= link_to "Sair", destroy_user_session_path, data: { turbo_method: :delete }, class: "text-error" %>
              </li>
            </ul>
          </div>
        <% else %>
          <%= link_to "Entrar", new_user_session_path, class: "btn btn-primary btn-sm rounded-field" %>
          <%= button_to "Visitante", guest_login_path, method: :post, class: "btn btn-ghost btn-sm rounded-field hidden sm:inline-flex" %>
        <% end %>
      </div>
    </header>

    <!-- Notifications -->
    <div class="container mx-auto px-4 mt-4">
      <% if notice.present? %>
        <div class="alert alert-info shadow-lg mb-4 rounded-field">
          <span>ℹ️</span>
          <span><%= notice %></span>
        </div>
      <% end %>
      <% if alert.present? %>
        <div class="alert alert-warning shadow-lg mb-4 rounded-field">
          <span>⚠️</span>
          <span><%= alert %></span>
        </div>
      <% end %>
    </div>

    <!-- Main Content -->
    <main class="flex-grow container mx-auto px-4 py-8 sm:py-10">
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="bg-base-100/70 backdrop-blur-md border-t border-base-content/10 mt-auto">
      <div class="container mx-auto px-4 py-4 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs tracking-wide text-base-content/45">
        <p>© <%= Time.current.year %> GameHub — Todos os direitos reservados.</p>
        <div class="flex gap-4 font-light">
          <%= link_to "Início", root_path, class: "hover:text-base-content/80 transition-colors" %>
          <%= link_to "Leaderboard", global_leaderboard_path, class: "hover:text-base-content/80 transition-colors" %>
          <%= link_to "Facebook", facebook_integration_path, class: "hover:text-base-content/80 transition-colors" %>
        </div>
      </div>
    </footer>
  </body>
</html>
