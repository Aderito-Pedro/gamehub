<div class="space-y-10">
  <!-- Hero Section -->
  <div class="relative overflow-hidden rounded-box border border-base-content/10 bg-base-100 p-8 md:p-14 isolate">
    <div class="absolute -top-24 -left-24 w-72 h-72 bg-primary/30 rounded-full blur-3xl -z-10"></div>
    <div class="absolute -bottom-24 -right-24 w-72 h-72 bg-secondary/30 rounded-full blur-3xl -z-10"></div>

    <div class="flex flex-col md:flex-row items-center justify-between gap-10">
      <div class="max-w-xl space-y-5 text-center md:text-left">
        <span class="badge badge-primary badge-outline font-semibold">🕹️ Jogue sem instalar nada</span>
        <h1 class="text-4xl md:text-6xl font-black tracking-tight leading-[1.05]">
          Os melhores jogos <span class="bg-gradient-to-r from-primary via-secondary to-accent bg-clip-text text-transparent">clássicos</span>, direto no navegador
        </h1>
        <p class="text-base-content/70 text-lg">
          Jogue lendas do arcade diretamente aqui ou no <span class="font-semibold text-base-content">Facebook</span>, salve suas pontuações e dispute o topo do ranking global.
        </p>
        <div class="flex flex-wrap gap-3 pt-2 justify-center md:justify-start">
          <%= link_to "🏆 Ver Rankings", global_leaderboard_path, class: "btn btn-primary rounded-field" %>
          <%= link_to "📘 Jogar no Facebook", facebook_integration_path, class: "btn btn-outline btn-secondary rounded-field" %>
        </div>
      </div>
      <div class="text-7xl md:text-9xl select-none animate-bounce drop-shadow-2xl">
        🎮
      </div>
    </div>
  </div>

  <!-- Search & Filters -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-base-100 p-4 rounded-box border border-base-content/10 shadow-sm">
    <%= form_with url: games_path, method: :get, class: "flex gap-2 w-full md:max-w-md", local: true do |f| %>
      <div class="relative w-full">
        <%= f.text_field :search, value: params[:search], placeholder: "Buscar jogos...", class: "input input-bordered rounded-field w-full pr-10" %>
        <% if params[:search].present? %>
          <%= link_to "✕", games_path, class: "absolute right-3 top-3 text-base-content/50 hover:text-base-content" %>
        <% end %>
      </div>
      <%= f.submit "Buscar", class: "btn btn-primary rounded-field" %>
    <% end %>

    <!-- Categories Tabs -->
    <div class="flex flex-wrap gap-2 justify-center md:justify-end">
      <%= link_to "Todos", games_path, class: "btn btn-sm rounded-full #{params[:category].blank? ? 'btn-primary' : 'btn-ghost bg-base-200'}" %>
      <% @categories.each do |cat| %>
        <%= link_to cat, games_path(category: cat), class: "btn btn-sm rounded-full #{params[:category] == cat ? 'btn-primary' : 'btn-ghost bg-base-200'}" %>
      <% end %>
    </div>
  </div>

  <!-- Games Grid -->
  <% if @games.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      <% @games.each do |game| %>
        <div class="card bg-base-100 shadow-md hover:shadow-2xl border border-base-content/10 hover:border-primary/40 transition-all duration-300 group hover:-translate-y-1.5">
          <figure class="bg-gradient-to-br from-primary/15 via-secondary/10 to-accent/10 h-40 flex items-center justify-center relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-t from-base-100/40 to-transparent"></div>
            <span class="text-7xl group-hover:scale-110 transition-transform duration-300 select-none drop-shadow-lg">
              <%= {
                'pong' => '🏓', 'snake' => '🐍', '2048' => '🔢', 'tetris' => '🧱',
                'flappy bird' => '🐦', 'breakout' => '🧱', 'memory' => '🃏',
                'maze chase' => '👻', 'speed racer' => '🏎️', 'platform hero' => '🦸',
                'tank duel' => '💥', 'bomb arena' => '💣', 'block smash' => '🔨',
                'star blaster' => '🚀'
              }.fetch(game.name.downcase, '🎮') %>
            </span>
            <div class="absolute top-2 right-2 badge badge-neutral badge-sm font-semibold"><%= game.category %></div>
          </figure>
          <div class="card-body p-5">
            <h2 class="card-title text-xl font-bold group-hover:text-primary transition-colors">
              <%= game.name %>
            </h2>
            <p class="text-sm text-base-content/70 line-clamp-2"><%= game.description %></p>
            <div class="card-actions justify-between items-center mt-4">
              <span class="text-xs text-base-content/50">🕹️ <%= game.plays_count %> jogadas</span>
              <%= link_to "Jogar", game_path(game), class: "btn btn-primary btn-sm rounded-field group-hover:scale-105 transition-transform" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-16 space-y-2">
      <div class="text-5xl">🔍</div>
      <p class="text-base-content/60 font-semibold">Nenhum jogo encontrado.</p>
      <%= link_to "Limpar filtros", games_path, class: "link link-primary" %>
    </div>
  <% end %>
</div>
